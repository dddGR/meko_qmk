{
    "keyboard_name": "meko",
    "manufacturer": "ddd",
    "url": "https://www.github.com/dddGR/meko",
    "maintainer": "dddGR",
    "board": "GENERIC_RP_RP2040",
    "bootloader": "rp2040",
