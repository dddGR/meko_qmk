            {"pin_a": "GP16", "pin_b": "GP15", "resolution": 1},
            {"pin_a": "GP29", "pin_b": "GP28" },
            {"pin_a": "GP4", "pin_b": "GP3"}
        ]
    },
    "diode_direction": "COL2ROW",
